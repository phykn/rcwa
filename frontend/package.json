{
  "name": "rcwa-workbench",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:engine": "vitest run -c vitest.engine.config.ts",
    "e2e": "npm run build && playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src e2e vite.config.ts vitest.engine.config.ts playwright.config.ts",
    "format": "prettier --write src e2e"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.180.0",
    "uplot": "^1.6.32",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.55.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.9.9",
    "pyodide": "^0.28.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.1.3",
    "vitest": "^4.1.11"
  }
}
